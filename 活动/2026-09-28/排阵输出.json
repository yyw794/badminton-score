  "design_notes": {
    "目标": "3场地 7轮 共21场：锚点不拆 + 无外援PK外援 + 男双干净组合(外援+内部兜底) + 能量均衡(能量=单打×2+双打×1，极差≤1) + 强度均衡",
    "锚点": "苏大哲/陈财贵 男双锁死(R1/R4/R5/R7 合体4场，R2/R3休；R6 重组轮拆开试搭 苏大哲+陈小洪 1场)",
    "第二男双": "刘继宇 固定 + 搭档轮换(陈顺星/严勇文；刘继宇/陈顺星≤3；严勇文/刘继宇≤3)（R2/R3/R5/R7，R1混双/R4混双/R6休）",
    "压轴对台": "R7 8号 苏大哲/陈财贵 vs 刘继宇/陈顺星（最强锚点 PK 第二男双）",
    "搭档定制(记忆)": "王小波/陈小洪 不合拍→禁配(永不同队)；王小波 指定搭档 罗蒙（R5 组队 vs 苏陈）；陈小洪 实力较弱→搭档分散（5 场全不同搭档：王苏丹/严勇文/范智强/苏大哲/罗蒙）",
    "男单": "范智强/罗蒙 固定对战（R6，各2场）",
    "女单": "李祺祺/项小英 固定对战（R4，各2场）",
    "女双": "纯女双 R1/R2/R3：徐越/李佳琳 vs 项小英/曹杨（项小英/曹杨 早回家优先，女双试搭前置；项小英 女单R4 后第 4 轮结束，曹杨 混双R5/R6 后第 6 轮结束）",
    "混双": "R1:李祺祺/滕菲；R2:李祺祺/滕菲；R3:李祺祺/滕菲；R4:徐越/李佳琳；R5:曹杨/滕菲；R6:曹杨/滕菲；R7:徐越/李佳琳",
    "能量均衡": "能量=单打×2+双打×1；硬约束极差≤1(女生/固定单打结构性定死，补位弱者李佳琳偏低端)，通用方差项往均值拉",
    "外援规则": "无外援PK外援：每场至多1队含外援(外援+外援同队允许)；混双至多1外援男",
    "男双组合": "最强锚点(苏陈)对手尽量挑强手(θ排序)；对手队组成优先 内部+内部/外援+外援，外援+内部 仅兜底",
    "强度": "BT θ 匹配；多解取最均衡"
