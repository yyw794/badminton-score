  "design_notes": {
    "目标": "场地2h=7场 共28场：锚点不拆 + 无外援PK外援 + 男双干净组合(外援+内部兜底) + 能量均衡(能量=单打×2+双打×1，极差≤2) + 强度均衡",
    "锚点": "苏大哲/陈财贵 男双锁死(7轮)；刘继宇/严勇文 男双锁死(R4休)；两队内战 R1 / R5",
    "试搭(重组轮)": "R1 / R3 / R5 锚点拆开重组：陈财贵/刘继宇 vs 苏大哲/严勇文（试搭；苏大哲/严勇文 搭一起不坐场）",
    "合练对": "林锋/黄冬青 男双合练≥2场；罗蒙/程建兴 男双合练≥1场（作锚点对手，固定同队；软目标：尽量对上两个锚点队互搞）",
    "换搭档(同队上限)": "卢志辉/陈小洪 同队≤3次(换搭档)",
    "单打": "范智强/罗琴荩 只打单打(各4场，不占双打/混双槽，把双打让给弱手压能量差)；对手优选4外援(程建兴/罗蒙/张欣欣/黄冬青，单人≤2场)",
    "开放男双": "R1 / R2 / R3 / R5 / R6 各1场(非锚点2v2)",
    "混双": "3混双；男生能量欠账者优先(抬低端)；每场至多1外援；种子不参与混双",
    "女单": "李祺祺 vs 李佳琳 (2场)",
    "能量均衡": "能量=单打×2+双打×1；硬约束极差≤2(全员能量落在[6,8])，种子只打单打 + 轮次结构保证每轮≤8个非锚点男，通用方差项往均值拉",
    "外援规则": "无外援PK外援：每场至多1队含外援(外援+外援同队允许)；混双每场至多1外援男",
    "男双组合": "对手队组成优先 内部+内部/外援+外援(锻炼内部默契)，外援+内部 仅兜底(软约束，低于局数平衡)；开放男双同组2外援时同队",
    "强度": "BT θ 匹配；指定组合(内战)优先，多解取最均衡"
  },
